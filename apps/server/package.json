{
  "name": "@hoteliva/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/web.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "build": "tsc",
    "start": "node dist/web.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "bootstrap": "tsx --env-file-if-exists=.env src/commands/bootstrap.ts",
    "test:browser-server": "tsx test/browser-server.ts"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "mongodb": "7.7.0",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
